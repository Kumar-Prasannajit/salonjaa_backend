# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGINS=http://localhost:3000

# Database
DATABASE_URL=postgres://postgres:postgres@localhost:5432/salonjaa
DATABASE_SSL=false

# Redis
REDIS_URL=redis://localhost:6379

# JWT
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# OTP
OTP_LENGTH=6
OTP_EXPIRY_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_RATE_LIMIT_WINDOW_SECONDS=3600
OTP_RATE_LIMIT_MAX=5

# Auth rate limiting
AUTH_RATE_LIMIT_WINDOW_SECONDS=900
AUTH_RATE_LIMIT_MAX=20
# Local/test convenience only; ignored when NODE_ENV=production
DISABLE_AUTH_RATE_LIMITS=false

# Booking
BOOKING_DEFAULT_EXPIRY_HOURS=12

# Booking — once a salon owner approves an ONLINE-payment booking, the customer has this
# long to pay before it auto-cancels (AWAITING_PAYMENT -> CANCELLED). 15 is the client's own
# originally-stated figure ("approve then 15-minute payment window").
BOOKING_PAYMENT_WINDOW_MINUTES=15

# Cookie auth (Module 14) — leave unset for local single-origin dev (frontend/backend share
# the same top-level domain, different ports). Only needed for a production deployment on a
# genuinely separate domain.
# COOKIE_DOMAIN=

# Payment — a PENDING order older than this auto-expires to FAILED (so create-order becomes
# retryable again) if POST /payments/verify is never called. Provisional numeric policy, same
# category as BOOKING_DEFAULT_EXPIRY_HOURS.
PAYMENT_ORDER_EXPIRY_MINUTES=20

# Razorpay (test mode keys from https://dashboard.razorpay.com/app/keys — use the "Test Mode"
# toggle, not live keys, for local dev). Only needed for POST /payments/create-order and
# POST /payments/verify; the app boots fine without these, but those two endpoints will fail
# at request time until both are set.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Email provider (MVP: log/dev provider unless SMTP set)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Salonjaa <no-reply@salonjaa.com>

# Logging
LOG_LEVEL=info
